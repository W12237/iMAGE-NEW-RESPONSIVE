model Partner {
  id            String   @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  logoUrl       String
  logoAltEn     String
  logoAltAr     String
  websiteUrl    String?
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  homepageId    String
  homepage      Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)

  @@index([homepageId, sortOrder])
}

model TeamMember {
  id         String   @id @default(cuid())
  nameEn     String
  nameAr     String
  roleEn     String
  roleAr     String
  bioEn      String
  bioAr      String
  imageUrl   String
  imageAltEn String
  imageAltAr String
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  homepageId String
  homepage   Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)

  @@index([homepageId, sortOrder])
}

model AboutContentBlock {
  id         String   @id @default(cuid())
  enabled    Boolean  @default(true)
  eyebrowEn  String
  eyebrowAr  String
  titleEn    String
  titleAr    String
  bodyEn     String
  bodyAr     String
  imageUrl   String?
  imageAltEn String?
  imageAltAr String?
  sortOrder  Int      @default(0)
  homepageId String
  homepage   Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)

  @@index([homepageId, sortOrder])
}

model AboutMilestone {
  id         String   @id @default(cuid())
  year       String
  titleEn    String
  titleAr    String
  bodyEn     String
  bodyAr     String
  imageUrl   String
  imageAltEn String
  imageAltAr String
  sortOrder  Int      @default(0)
  homepageId String
  homepage   Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)
}

model Stat {
  id         String   @id @default(cuid())
  valueEn    String
  valueAr    String
  unitEn     String?
  unitAr     String?
  labelEn    String
  labelAr    String
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  homepageId String
  homepage   Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)
}

model Project {
  id                  String        @id @default(cuid())
  slug                String        @unique
  nameEn              String
  nameAr              String
  shortDescriptionEn  String
  shortDescriptionAr  String
  fullDescriptionEn   String?
  fullDescriptionAr   String?
  locationEn          String
  locationAr          String
  coverImageUrl       String
  coverImageAltEn     String
  coverImageAltAr     String
  coverImageFocalPoint String       @default("center")
  gallery             String        @default("[]")
  logoUrl             String?
  ctaLabelEn          String?
  ctaLabelAr          String?
  ctaUrl              String?
  status              ContentStatus @default(DRAFT)
  featured            Boolean       @default(false)
  featuredOrder       Int           @default(0)
  projectType         String        @default("Residential") // Residential | Commercial | Medical
  progressStatus      String        @default("Ongoing")     // Ongoing | Delivered | Upcoming
  masterPlanUrl       String?
  brochureUrl         String?
  videoTourUrl        String?
  latitude            Float?
  longitude           Float?
  mapUrl              String?
  keyFacts            String        @default("[]")
  highlights          String        @default("[]")
  unitTypes           String        @default("[]")
  nearbyLocations     String        @default("[]")
  constructionUpdates String        @default("[]")
  seoTitleEn          String?
  seoTitleAr          String?
  seoDescriptionEn    String?
  seoDescriptionAr    String?
  ogImageUrl          String?
  projectCode         String?
  addressEn           String?
  addressAr           String?
  directionsUrl       String?
  mobileHeroImageUrl  String?
  heroVideoUrl        String?
  heroVideoPosterUrl  String?
  cardImageUrl        String?
  heroTitleEn         String?
  heroTitleAr         String?
  heroDescriptionEn   String?
  heroDescriptionAr   String?
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  keyFactsList            ProjectKeyFact[]
  highlightsList          ProjectHighlight[]
  unitTypesList           ProjectUnitType[]
  galleryItemList         ProjectGalleryItem[]
  constructionUpdatesList ProjectConstructionUpdate[]
  connectivityList        ProjectConnectivity[]
  visualTours             ProjectVisualTour[]
}

model ProjectKeyFact {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labelEn   String
  labelAr   String
  valueEn   String
  valueAr   String
  unitEn    String?
  unitAr    String?
  icon      String?
  sortOrder Int     @default(0)

  @@index([projectId, sortOrder])
}

model ProjectHighlight {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  imageUrl      String?
  icon          String?
  sortOrder     Int     @default(0)

  @@index([projectId, sortOrder])
}

model ProjectUnitType {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  titleEn       String
  titleAr       String
  areaEn        String?
  areaAr        String?
  areaRange     String?
  areaUnit      String  @default("sqm")
  finishingEn   String?
  finishingAr   String?
  descriptionEn String?
  descriptionAr String?
  paymentPlanEn String?
