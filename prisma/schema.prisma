/// Ordered page-builder blocks: custom content sections and positioned built-in sections.
model PageSection {
  id            String   @id @default(cuid())
  page          String
  /// CUSTOM, or a built-in block key from src/lib/page-blocks.ts
  kind          String   @default("CUSTOM")
  layout        String   @default("TEXT")
  eyebrowEn     String   @default("")
  eyebrowAr     String   @default("")
  titleEn       String
  titleAr       String
  bodyEn        String   @default("")
  bodyAr        String   @default("")
  imageUrl      String?
  imageAltEn    String   @default("")
  imageAltAr    String   @default("")
  ctaLabelEn    String   @default("")
  ctaLabelAr    String   @default("")
  ctaUrl        String?
  backgroundRgb String   @default("255, 255, 255")
  /// JSON style settings, see src/lib/block-settings.ts
  settings      String   @default("{}")
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([page, visible, sortOrder])
}
